# Copy to .env (gitignored) and fill in. Real environment variables override this file.

# LLM provider for answering, captioning (baseline) and judging: anthropic | gemini
FIELDNOTE_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional model overrides (defaults: claude-opus-5 / gemini-2.5-flash)
# FIELDNOTE_ANSWER_MODEL=
# FIELDNOTE_CAPTION_MODEL=
# FIELDNOTE_JUDGE_MODEL=
# FIELDNOTE_ANSWER_EFFORT=low
